{
    "name": "codex-deck",
    "version": "0.2.0",
    "description": "A Stream Deck+ control surface backed by Codex app-server.",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "rollup -c",
        "typecheck": "tsc --noEmit",
        "test": "node --import tsx --test test/**/*.test.ts",
        "check": "npm run typecheck && npm test && npm run docs:check && npm run build && npm run validate",
        "docs:check": "node scripts/validate-docs.mjs",
        "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.mahdi.codex-deck\"",
        "dev:codex": "node --import tsx src/dev/console.ts",
        "doctor:wsl": "node --import tsx src/dev/wsl-doctor.ts",
        "generate:codex-schema": "codex app-server generate-ts --out ./generated/codex",
        "validate": "streamdeck validate --no-update-check com.mahdi.codex-deck.sdPlugin",
        "pack": "npm run build && streamdeck pack --force --no-update-check com.mahdi.codex-deck.sdPlugin"
    },
    "dependencies": {
        "@elgato/streamdeck": "^2.1.0"
    },
    "devDependencies": {
        "@elgato/cli": "^1.7.4",
        "@rollup/plugin-commonjs": "^29.0.2",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@rollup/plugin-typescript": "^12.1.4",
        "@tsconfig/node24": "^24.0.4",
        "@types/node": "^24.10.1",
        "jsdom": "^29.1.1",
        "mermaid": "^11.16.0",
        "rollup": "^4.50.0",
        "tslib": "^2.8.1",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
    }
}
